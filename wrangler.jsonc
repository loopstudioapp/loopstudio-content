{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "content-loopstudio",
  "main": "worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Owner dashboard data (moved from Supabase on 2026-10-11). Schema: d1/migrations/
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "content-dashboard",
      "database_id": "8b8df6d2-b3b6-4551-a951-5a6b4453760a",
      "migrations_dir": "d1/migrations"
    }
  ],
  // Calendar task images (moved from Supabase Storage on 2026-10-11).
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "content-dashboard-images" }],
  "services": [
    // Used by OpenNext and by the cron handler (each job = its own request).
    { "binding": "WORKER_SELF_REFERENCE", "service": "content-loopstudio" }
  ],
  "limits": {
    // Paid plan maximum (5 min CPU). Vercel ran these routes with maxDuration 300.
    "cpu_ms": 300000,
    // The nightly RevenueCat reconcile reads events for every known subscriber
    // (paginated, plus D1 calls); the paid default is 10,000.
    "subrequests": 50000
  },
  "triggers": {
    // Same schedules as vercel.json (UTC). Jobs per schedule: cloudflare/cron.ts
    "crons": ["5 0 * * *", "0 16 * * *", "0 18 * * *"]
  },
  // Live since 2026-10-09 (moved from Vercel); the workers.dev address stays for testing.
  "routes": [{ "pattern": "content.loopstudio.tech", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
